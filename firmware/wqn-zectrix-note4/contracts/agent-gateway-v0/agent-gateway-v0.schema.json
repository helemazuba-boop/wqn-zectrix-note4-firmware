{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wqn.helema.cn/contracts/agent-gateway-v0/agent-gateway-v0.schema.json",
  "title": "WQN ESP32 Agent Gateway Protocol v0",
  "description": "Language-neutral contract for the /api/esp32/agent/* routes that proxy a bound self-hosted OpenCode server. Replaces the retired X-WQN-Ai-Tier: pro tier.",
  "$defs": {
    "sessionId": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128,
      "pattern": "^ses_[A-Za-z0-9_-]+$",
      "description": "Opaque to the device; the ses_ prefix is the only part it inspects."
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/sessionId" },
        "title": { "type": "string", "maxLength": 256 },
        "updatedAt": { "type": "integer", "minimum": 0 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$"
        },
        "message": { "type": "string", "maxLength": 512 }
      }
    },
    "sessionsListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessions"],
          "properties": {
            "sessions": {
              "type": "array",
              "maxItems": 12,
              "items": { "$ref": "#/$defs/session" }
            }
          }
        }
      }
    },
    "sessionCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Empty object; the gateway derives the session from the binding."
    },
    "sessionCreateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session"],
          "properties": {
            "session": { "$ref": "#/$defs/session" }
          }
        }
      }
    },
    "transcribeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transcript"],
          "properties": {
            "transcript": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        }
      }
    },
    "runRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "confirmed"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "confirmed": {
          "type": "boolean",
          "const": true,
          "description": "The device only ever sends a confirmed prompt; the option bar is where the user says yes."
        }
      }
    },
    "permissionReplyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permission_id", "decision", "confirmed"],
      "properties": {
        "permission_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "decision": { "enum": ["once", "reject"] },
        "confirmed": { "type": "boolean", "const": true }
      }
    },
    "streamFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": {
          "enum": [
            "agent.accepted",
            "agent.attached",
            "agent.status",
            "agent.text.delta",
            "agent.text",
            "agent.tool",
            "agent.permission",
            "agent.error"
          ]
        },
        "data": {
          "type": "object",
          "description": "JSON payload of the SSE data: line. Empty for the two acknowledgements."
        }
      }
    },
    "runStream": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/streamFrame" },
      "description": "Ordered SSE frames of one run. Must terminate with agent.status {status: idle}."
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": { "$ref": "#/$defs/error" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/sessionsListResponse" },
    { "$ref": "#/$defs/sessionCreateResponse" },
    { "$ref": "#/$defs/transcribeResponse" },
    { "$ref": "#/$defs/errorEnvelope" }
  ]
}
