CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/16m.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# [hang-fix] A TWDT-subscribed task that stops feeding (wedged SPI transmit,
# stuck bus lock) must panic with a backtrace and reset, not just print a
# warning forever: the EPD render window and the UI task's idle power-off
# window rely on this for self-healing.
CONFIG_ESP_TASK_WDT_PANIC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
# [ai-memory-fix] Prefer WiFi/LwIP allocations in the 8 MiB PSRAM pool so TLS
# task creation keeps enough internal SRAM for stacks and DMA-only objects.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n

CONFIG_SPI_FLASH_VERIFY_WRITE=y
# Pack downloads may reclaim up to 1 MiB of deleted SPIFFS pages inside the
# serialized storage worker before reporting a real capacity block.
CONFIG_SPIFFS_GC_MAX_RUNS=256

# WebSocket transport: nginx reverse proxy returns a large upgrade response
# (INGRESSCOOKIE + many access-control-* + x-stainless-* headers) that exceeds
# the default 1024-byte buffer and aborts the WS handshake with
# "Header size exceeded buffer size". 4096 is plenty for any sane proxy.
CONFIG_WS_BUFFER_SIZE=4096
