menu "WQN firmware"

    config WQN_WIFI_STA_ENABLE
        bool "Enable WQN WiFi station"
        default n
        help
            Enable the minimal WiFi station flow. Keep this disabled for the
            offline board-diagnostics build and until CMOS5 plus backup restore
            checks are complete.

    config WQN_WIFI_SSID
        string "WQN WiFi SSID"
        default ""
        depends on WQN_WIFI_STA_ENABLE
        help
            Development WiFi SSID. This value is stored only in local sdkconfig,
            which is ignored by git.

    config WQN_WIFI_PASSWORD
        string "WQN WiFi password"
        default ""
        depends on WQN_WIFI_STA_ENABLE
        help
            Development WiFi password. This value is stored only in local
            sdkconfig, which is ignored by git.

    config WQN_PROVISION_ENABLE
        bool "Enable WiFi provisioning (SoftAP + captive portal)"
        default y
        depends on WQN_WIFI_STA_ENABLE
        help
            Enable in-app WiFi provisioning for new users with no saved
            credentials. Starts a captive portal on SoftAP "ZECTRIX_XXXX"
            at http://192.168.4.1 when no NVS WiFi credentials are found.
            Set to n only when using a fixed compile-time SSID/password
            or when the device is always offline.

    config WQN_EPD_UI_ENABLE
        bool "Enable ZecTrix Note4 e-paper UI"
        default n
        help
            Enable the first hardware UI path using the Note4 400x300 e-paper
            panel and physical buttons. This powers GPIO6 for display refreshes.
            Keep disabled for headless network-only builds.

    config WQN_EPD_LOCAL_PARTIAL_ENABLE
        bool "Enable local EPD partial-window refresh"
        default y
        depends on WQN_EPD_UI_ENABLE
        help
            Enable the Note4 controller's 0x83 local partial-window refresh
            path. This keeps the EPD rail powered after refreshes so the panel
            controller can preserve hot-refresh state between UI operations.

    config WQN_EPD_PARTIAL_COOLDOWN_MS
        int "EPD local partial cooldown in milliseconds"
        default 450
        range 0 2000
        depends on WQN_EPD_LOCAL_PARTIAL_ENABLE
        help
            Minimum delay between local partial refreshes. The closed firmware
            waits for both BUSY release and a software cooldown before sending
            the next 0x83 window.

    config WQN_EPD_IDLE_POWER_OFF_MS
        int "Power off EPD rail after UI idle milliseconds"
        default 1500
        range 0 600000
        depends on WQN_EPD_UI_ENABLE
        help
            Cut GPIO6 after the UI has been idle for this long. The previous
            framebuffer stays synced in CPU memory, so later partial refreshes
            can still diff against the visible panel image after a cold rail
            restart. Set 0 to keep the EPD rail on as long as the firmware is
            running.

    config WQN_DEEP_SLEEP_ENABLE
        bool "Enable deep sleep after UI idle"
        default y
        depends on WQN_EPD_UI_ENABLE
        help
            Enter ESP32-S3 deep sleep after the UI has been idle. Wake sources
            are RTC-capable GPIO0, GPIO18, and GPIO5. GPIO39 cannot wake from
            deep sleep on ESP32-S3. GPIO17 is held high to preserve board power.

    config WQN_DEEP_SLEEP_IDLE_MS
        int "Deep sleep idle timeout in milliseconds"
        default 60000
        range 10000 86400000
        depends on WQN_DEEP_SLEEP_ENABLE
        help
            Idle time before entering deep sleep. Default 60 seconds for normal use.

    config WQN_DEEP_SLEEP_TIMER_WAKE_SEC
        int "Deep sleep timer wake interval in seconds"
        default 0
        range 0 86400
        depends on WQN_DEEP_SLEEP_ENABLE
        help
            Optional RTC timer wake interval. Set 0 to wake only from GPIO0,
            GPIO18, or GPIO5.

    config WQN_AI_ENABLE
        bool "Enable WQN AI firmware modules"
        default n
        help
            Enable experimental AI support modules. Provider secrets must stay
            on the WQN server and must never be embedded in firmware.

    config WQN_AI_STREAMING_ENABLE
        bool "Enable v2 SSE streaming for Std/Pro AI tier (new default)"
        default y
        depends on WQN_AI_ENABLE
        help
            When enabled, STD/PRO tiers request X-WQN-Protocol: v2-streaming
            and consume an SSE event stream from POST /api/esp32/ai/transcribe-chat.
            The firmware renders partial ASR delta, assistant transcript deltas,
            tool calls, and incremental status chips to the EPD as events arrive.
            When disabled, falls back to the legacy v1 one-shot JSON response.

    config WQN_AI_V1_FALLBACK
        bool "Compile legacy v1 one-shot JSON path (debug fallback)"
        default y
        depends on WQN_AI_ENABLE
        help
            Keeps the legacy UploadAiAudioChat() + HttpBinaryPost() path compiled
            behind a macro so the firmware can be temporarily rebuilt for
            comparison against the v2 SSE stream. Used at runtime only when
            WQN_AI_STREAMING_ENABLE is n.

    config WQN_FLASH_PROTOCOL_V2
        bool "Flash mode uses the wqn-flash-v2 Realtime protocol (WQN proxy)"
        default y
        depends on WQN_AI_ENABLE
        help
            The new WS endpoint is wss://wqn.helema.cn/api/esp32/realtime with
            Sec-WebSocket-Protocol: wqn-flash-v2. Uplink audio is PCM16 binary
            frames (480 B each), downlink TTS audio is also binary and is
            rendered to ES8311 via the existing flash I2S duplex path.
            Disable only to fall back to the legacy StepFun-shaped protocol.

    config WQN_AI_AUDIO_SELFTEST_ENABLE
        bool "Run WQN audio capture self-test at boot"
        default n
        depends on WQN_AI_ENABLE
        help
            Initialize the ES8311/I2S microphone path, capture a short sample,
            print channel RMS/peak statistics over serial, then power audio off.
            This mode does not upload audio or start WiFi by itself.

    config WQN_BATTERY_LOW_THRESHOLD_MV
        int "Battery low shutdown threshold in millivolts"
        default 3450
        help
            When battery voltage drops below this and USB is not connected,
            the device shuts down. Official firmware uses 3450mV (3.45V).

    config WQN_BATTERY_OTA_THRESHOLD_PCT
        int "Minimum battery percent for OTA upgrades"
        default 50
        help
            Prevent OTA upgrades when battery is below this threshold.
            From official firmware string: "电量不足...请充电至50%%以上"

    config WQN_CHARGING_DEEP_SLEEP_EXTRA_MS
        int "Extra idle time before deep sleep when charging (ms)"
        default 300000
        help
            When charging, extend deep sleep idle timeout by this amount
            so the device stays awake longer for syncing/updates.
            Default 5 minutes extra.

endmenu
