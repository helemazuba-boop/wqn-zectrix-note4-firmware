CONFIG_WQN_WIFI_STA_ENABLE=y
CONFIG_WQN_DEVICE_CONTROL_V3_ENABLE=y
CONFIG_WQN_AI_ENABLE=y
# CONFIG_WQN_AI_AUDIO_SELFTEST_ENABLE is not set
CONFIG_WQN_EPD_UI_ENABLE=y
CONFIG_WQN_EPD_LOCAL_PARTIAL_ENABLE=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_DFS_INIT_AUTO=y
# Native USB Serial/JTAG cannot answer host traffic in automatic light sleep.
# Let ESP-IDF hold its own NO_LIGHT_SLEEP lock whenever USB SOF frames prove a
# PC is connected; PowerCoordinator separately uses the same signal to block
# deep sleep.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
CONFIG_WQN_DEEP_SLEEP_ENABLE=y
CONFIG_WQN_RETAINED_STANDBY_IDLE_MS=60000
CONFIG_WQN_DEEP_SLEEP_IDLE_MS=1800000
CONFIG_WQN_DEEP_SLEEP_TIMER_WAKE_SEC=0
